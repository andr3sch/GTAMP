<Project Sdk="Microsoft.NET.Sdk">

  <!-- Launcher Desktop (Windows Forms, .NET 8) para listar servidores, configurar mp_config.ini e abrir o GTA V -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GTAMP.Launcher</RootNamespace>
    <AssemblyName>GTAMP.Launcher</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GTAMP.Shared\GTAMP.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="servers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
